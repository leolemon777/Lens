{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main dashboard access to product commands.",
    "windows": ["main", "overlay", "pin", "island", "quick-access", "record-bar"],
  "remote": {
    "urls": ["http://127.0.0.1:*", "http://127.0.0.1/*"]
  },
  "permissions": ["allow-lens-product", "core:default", "core:webview:default", "core:window:default", "core:window:allow-hide", "core:window:allow-close", "core:window:allow-set-size", "core:window:allow-start-dragging"]
}
