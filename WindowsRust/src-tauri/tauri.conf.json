{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lens Windows",
  "version": "0.1.0",
  "identifier": "dev.leolemon777.lens.windows",
  "build": { "frontendDist": "../frontend" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main", "title": "Lens Windows", "width": 1160, "height": 790,
      "minWidth": 860, "minHeight": 640, "center": true,
      "backgroundColor": "#f6f7fb", "dragDropEnabled": false
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; media-src 'self' asset: http://asset.localhost blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "assetProtocol": { "enable": true, "scope": [] },
      "capabilities": ["main", "region"]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } }
  }
}
